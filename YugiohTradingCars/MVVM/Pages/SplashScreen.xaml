<Page x:Class="YugiohTradingCars.MVVM.Pages.SplashScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YugiohTradingCars.MVVM.Pages"
      xmlns:viewModel="clr-namespace:YugiohTradingCars.MVVM.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SplashScreen">


    <Page.Resources>
        <ResourceDictionary>
            <viewModel:SplashScreenViewModel x:Key="ViewModel"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFGlobalStyles/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.DataContext>
        <Binding Source="{StaticResource ViewModel}" x:Name="vm"/>
    </Page.DataContext>

    <Grid>
           
        <Image x:Name="SplashScreenImage" Source="{StaticResource SplashScreenDefault}">
            <Image.Triggers>
                <EventTrigger RoutedEvent="Image.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation
                                Storyboard.TargetProperty="Opacity"
                                Storyboard.TargetName="SplashScreenImage"
                                From="1.0"
                                To="0.2"
                                Duration="0:0:1.5"
                                RepeatBehavior="Forever"
                                AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Image.Triggers>
        </Image>
    </Grid>

</Page>
